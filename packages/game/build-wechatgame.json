{
  "platform": "wechatgame",
  "buildPath": "project://build",
  "outputName": "wechatgame",
  "debug": false,
  "sourceMaps": false,
  "buildMode": "normal",
  "engineModulesConfigKey": "defaultConfig",
  "skipCompressTexture": false,
  "md5Cache": false,
  "experimentalEraseModules": true,
  "inlineEnum": true,
  "mangleProperties": true,
  "polyfills": {
    "asyncFunctions": false
  },
  "nativeCodeBundleMode": "wasm",
  "wasmCompressionMode": true,
  "includeModules": [
    "base",
    "gfx-webgl",
    "2d",
    "ui",
    "mask",
    "graphics",
    "audio",
    "tween",
    "custom-pipeline",
    "custom-pipeline-builtin-scripts"
  ],
  "useSplashScreen": false,
  "splashScreen": {
    "displayRatio": 1,
    "totalTime": 0,
    "watermarkLocation": "default",
    "autoFit": true,
    "logo": {
      "type": "custom",
      "image": "b17cddfc-7b37-4989-b8cf-22bf64e96fbc",
      "base64": ""
    },
    "background": {
      "type": "color",
      "color": {
        "x": 1,
        "y": 0.94,
        "z": 0.83,
        "w": 1
      }
    }
  },
  "bundleCommonChunk": false,
  "mainBundleCompressionType": "merge_dep",
  "mainBundleIsRemote": true,
  "remoteServerAddress": "https://hongshu.sale",
  "startSceneAssetBundle": false,
  "startScene": "104fa7bd-69cf-44b8-8ed1-bfc9af55e101",
  "scenes": [
    {
      "url": "db://assets/main.scene",
      "uuid": "104fa7bd-69cf-44b8-8ed1-bfc9af55e101"
    }
  ],
  "overwriteProjectSettings": {
    "macroConfig": {
      "cleanupImageCache": "on"
    },
    "includeModules": {
      "physics": "off",
      "physics-2d": "off",
      "gfx-webgl2": "off"
    }
  },
  "packages": {
    "wechatgame": {
      "separateEngine": false,
      "wasmSubpackage": true
    }
  },
  "bundleConfigs": [
    {
      "name": "resources",
      "root": "db://assets/resources",
      "compressionType": "merge_dep",
      "isRemote": true,
      "output": true
    }
  ]
}
