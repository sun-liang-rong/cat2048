{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "assets/scripts/core/**/*.ts",
    "assets/scripts/ui/styles/layout.ts",
    "assets/scripts/ui/utils/resourceLoading.ts",
    "assets/scripts/ui/utils/startupSequence.ts",
    "assets/scripts/ui/utils/settingsNavigation.ts",
    "assets/scripts/infrastructure/HapticController.ts",
    "assets/scripts/infrastructure/WechatShare.ts",
    "assets/scripts/features/leaderboard/leaderboard.ts",
    "assets/scripts/infrastructure/ResultShareController.ts",
    "assets/scripts/features/storage/storage.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/runtime-assets.test.ts",
    "tests/swipeDirection.test.ts",
    "tests/swipeInput.test.ts"
  ]
}
